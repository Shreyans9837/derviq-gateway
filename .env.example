# =========================
# DERVIQ ENVIRONMENT
# =========================

APP_ENV=production
HOST=0.0.0.0
PORT=8080

# PostgreSQL
# IMPORTANT: Real value Render Environment Variables me rakho.
DATABASE_URL=YOUR_RENDER_INTERNAL_DATABASE_URL

# Security
# Generate a long random value; don't use this example in production.
API_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Proxy / upstream security
UPSTREAM_ALLOWLIST=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Request limits
MAX_REQUEST_BYTES=10485760

# Logging
LOG_LEVEL=INFO
